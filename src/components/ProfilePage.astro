---
import Layout from "../layouts/Layout.astro";
import ElementBadge from "./ElementBadge.astro";
import PalAvatar from "./PalAvatar.astro";
import AdoptProfileButton from "./AdoptProfileButton";
import { ChevronLeftIcon } from "./icons";
import { readProfile, GitHubNotConfiguredError } from "../lib/github";
import { getBuildSummaries } from "../lib/data";
import { elementBadgeStyle } from "../lib/elementColors";
import type { Locale } from "../lib/taxonomy";
import { t, buildPath, profilePath } from "../lib/i18n";

interface Props {
  id: string;
  locale: Locale;
}

const { id, locale } = Astro.props;
const strings = t(locale);

let favoriteIds: string[] = [];
let backendError: "not_configured" | "unavailable" | null = null;
try {
  const existing = await readProfile(id);
  favoriteIds = existing?.profile.favorites ?? [];
} catch (err) {
  backendError = err instanceof GitHubNotConfiguredError ? "not_configured" : "unavailable";
}

const favoriteIdSet = new Set(favoriteIds);
const favoriteBuilds = getBuildSummaries(locale).filter((b) => favoriteIdSet.has(b.id));
const title = strings.profileViewTitleTemplate.replace("{id}", id);
const otherLocaleHref = locale === "es" ? profilePath("en", id) : profilePath("es", id);
---

<Layout title={title} description={strings.profileShareHint} locale={locale} noindex>
  <nav class="site-nav" aria-label={strings.navPrimary}>
    <a href={buildPath(locale)} class="brand-lockup">
      <span class="brand-mark" aria-hidden="true">P</span>
      <span>
        <span class="brand-name block">Palworld Builds</span>
        <span class="brand-kicker">Field guide / 1.0</span>
      </span>
    </a>
    <a href={otherLocaleHref} class="locale-link">{strings.localeSwitchTo}</a>
  </nav>

  <main class="detail-shell">
    <div class="detail-topbar">
      <a href={buildPath(locale)} class="back-link"><ChevronLeftIcon class="size-4" /> {strings.backToList}</a>
      <span class="eyebrow">{strings.collectionTitle}</span>
    </div>

    <header class="detail-hero">
      <div>
        <p class="eyebrow">{strings.catalogEyebrow}</p>
        <h1 class="detail-title">{title}</h1>
        <p class="detail-summary">{strings.profileShareHint}</p>
      </div>
      {!backendError && (
        <div class="detail-favorite">
          <AdoptProfileButton
            client:visible
            id={id}
            label={strings.profileAdoptButton}
            errorLabel={strings.profileErrorUnavailable}
            redirectTo={buildPath(locale)}
          />
        </div>
      )}
    </header>

    <section class="profile-collection">
      {backendError ? (
        <div class="empty-state">
          <strong>{strings.noMatchesHeading}</strong>
          <p>{strings.profileErrorUnavailable}</p>
        </div>
      ) : favoriteBuilds.length === 0 ? (
        <div class="empty-state">
          <strong>{strings.noMatchesHeading}</strong>
          <p>{strings.profileEmptyState}</p>
        </div>
      ) : (
        <ul role="list" class="build-grid">
          {favoriteBuilds.map((build, index) => (
            <li class="build-card" style={`--card-accent: ${elementBadgeStyle(build.elements[0] ?? "neutral")["--el-text"]}`}>
              <div class="build-card-top">
                <div>
                  <span class="build-card-index">{String(index + 1).padStart(2, "0")} / BUILD</span>
                  <h3><a href={`${buildPath(locale)}builds/${build.slug}/`}>{build.name}</a></h3>
                </div>
              </div>
              <p class="build-card-summary">{build.summary}</p>
              <div class="build-card-meta">
                {build.elements.map((element) => <ElementBadge element={element} locale={locale} />)}
              </div>
              <div class="build-card-team">
                <div class="pal-stack" aria-label={build.pals.map((pal) => pal.name).join(", ")}>
                  {build.pals.map((pal) => <PalAvatar iconUrl={pal.iconUrl} name={pal.name} class="size-9" />)}
                </div>
                <span class="build-card-arrow" aria-hidden="true">↗</span>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>
  </main>
</Layout>
