---
import Layout from "../layouts/Layout.astro";
import BuildBrowser from "./BuildBrowser";
import ProfileControl from "./ProfileControl";
import { getBuildSummaries } from "../lib/data";
import { taxonomyLabels, type Locale } from "../lib/taxonomy";
import { t, buildPath } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const labels = taxonomyLabels(locale);
const builds = getBuildSummaries(locale);

const toOptions = (map: Map<string, string>) => [...map].map(([value, label]) => ({ value, label }));

function activeOptions(options: { value: string; label: string }[], key: string) {
  const activeValues = new Set<string>();
  for (const build of builds) {
    const value = (build as Record<string, unknown>)[key];
    if (Array.isArray(value)) value.forEach((item) => activeValues.add(item as string));
    else if (typeof value === "string") activeValues.add(value);
  }
  return options.filter((option) => activeValues.has(option.value));
}

const purposeOptions = activeOptions(toOptions(labels.purpose), "purpose");
const elementOptions = activeOptions(toOptions(labels.element), "elements");
const progressionOptions = activeOptions(toOptions(labels.progression), "progression");
const requirementOptions = activeOptions(toOptions(labels.requirement), "requirements");
---

<Layout title={strings.pageTitle} description={strings.tagline} locale={locale}>
  <nav class="site-nav" aria-label={strings.navPrimary}>
    <a href={buildPath(locale)} class="brand-lockup">
      <span class="brand-mark" aria-hidden="true">P</span>
      <span>
        <span class="brand-name block">Palworld Builds</span>
        <span class="brand-kicker">Field guide / 1.0</span>
      </span>
    </a>
    <a href={strings.localeSwitchHref} class="locale-link">{strings.localeSwitchTo}</a>
  </nav>

  <main class="page-wrap">
    <section class="hero-grid" aria-labelledby="home-title">
      <div>
        <p class="eyebrow">{strings.heroEyebrow}</p>
        <h1 id="home-title" class="hero-title">{strings.heroTitleLead} <em>{strings.heroTitleAccent}</em></h1>
        <p class="hero-copy">{strings.heroCopy}</p>
      </div>
      <div class="hero-note">
        <p>{strings.heroNoteOne}</p>
        <p class="mt-4">{strings.heroNoteTwo}</p>
      </div>
    </section>

    <section class="profile-strip" aria-label={strings.profileStripLabel}>
      <div>
        <strong>{strings.collectionTitle}</strong>
        <p>{strings.collectionDescription}</p>
      </div>
      <ProfileControl
        client:load
        strings={{
          profileHint: strings.profileHint,
          profilePlaceholder: strings.profilePlaceholder,
          profileJoinButton: strings.profileJoinButton,
          profileActiveTemplate: strings.profileActiveTemplate,
          profileLeaveButton: strings.profileLeaveButton,
          profileErrorInvalid: strings.profileErrorInvalid,
          profileErrorUnavailable: strings.profileErrorUnavailable,
          profileErrorNotYours: strings.profileErrorNotYours,
        }}
      />
    </section>

    <BuildBrowser
      client:load
      builds={builds}
      purposeOptions={purposeOptions}
      elementOptions={elementOptions}
      progressionOptions={progressionOptions}
      requirementOptions={requirementOptions}
      buildHrefTemplate={`${buildPath(locale)}builds/{slug}/`}
      strings={{
        searchLabel: strings.searchLabel,
        searchPlaceholder: strings.searchPlaceholder,
        filterLegendPurpose: strings.filterLegendPurpose,
        filterLegendElement: strings.filterLegendElement,
        filterLegendProgression: strings.filterLegendProgression,
        filterLegendRequirement: strings.filterLegendRequirement,
        favoritesOnly: strings.favoritesOnly,
        clearFilters: strings.clearFilters,
        resultsCountTemplate: strings.resultsCountTemplate,
        emptyState: strings.emptyState,
        requiredEquipmentBadge: strings.requiredEquipmentBadge,
        saveFavorite: strings.saveFavorite,
        removeFavorite: strings.removeFavorite,
        filtersLabel: strings.filtersLabel,
        catalogEyebrow: strings.catalogEyebrow,
        catalogHeading: strings.catalogHeading,
        noMatchesHeading: strings.noMatchesHeading,
        emptyStateHint: strings.emptyStateHint,
      }}
    />
  </main>
</Layout>
