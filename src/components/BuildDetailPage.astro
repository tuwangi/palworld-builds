---
import Layout from "../layouts/Layout.astro";
import Badge from "./Badge.astro";
import ElementBadge from "./ElementBadge.astro";
import PalAvatar from "./PalAvatar.astro";
import ItemIcon from "./ItemIcon.astro";
import DetailFavoriteButton from "./DetailFavoriteButton";
import { ChevronLeftIcon } from "./icons";
import type { BuildDetail } from "../lib/data";
import { taxonomyLabels, type Locale } from "../lib/taxonomy";
import { t, buildPath } from "../lib/i18n";

interface Props {
  build: BuildDetail;
  locale: Locale;
}

const { build, locale } = Astro.props;
const strings = t(locale);
const labels = taxonomyLabels(locale);
const capturedDate = new Date(build.source.capturedAt).toLocaleDateString(strings.dateLocale, {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const otherLocaleHref = locale === "es" ? buildPath("en", build.slug) : buildPath("es", build.slug);
const uniqueRequirements = build.requirements.filter((requirement) => !build.purpose.includes(requirement));
---

<Layout title={`${build.name} — Palworld Builds`} description={build.summary} locale={locale}>
  <nav class="site-nav" aria-label="Primary navigation">
    <a href={buildPath(locale)} class="brand-lockup">
      <span class="brand-mark" aria-hidden="true">P</span>
      <span>
        <span class="brand-name block">Palworld Builds</span>
        <span class="brand-kicker">Field guide / 1.0</span>
      </span>
    </a>
    <a href={otherLocaleHref} class="locale-link">{strings.localeSwitchTo}</a>
  </nav>

  <main class="detail-shell">
    <div class="detail-topbar">
      <a href={buildPath(locale)} class="back-link"><ChevronLeftIcon class="size-4" /> {strings.backToList}</a>
      <span class="eyebrow">{strings.detailDossier}</span>
    </div>

    <header class="detail-hero">
      <div>
        <p class="eyebrow">{labels.progression.get(build.progression) ?? build.progression} / {labels.verification.get(build.verification) ?? build.verification}</p>
        <h1 class="detail-title">{build.name}</h1>
        <p class="detail-summary">{build.summary}</p>
        <div class="detail-badges">
          {build.elements.map((element) => <ElementBadge element={element} locale={locale} />)}
          {build.purpose.map((purpose) => <Badge>{labels.purpose.get(purpose) ?? purpose}</Badge>)}
          {uniqueRequirements.map((requirement) => <Badge>{labels.requirement.get(requirement) ?? requirement}</Badge>)}
        </div>
      </div>
      <div class="detail-favorite">
        <DetailFavoriteButton client:load buildId={build.id} labels={{ save: strings.saveFavorite, remove: strings.removeFavorite }} />
      </div>
    </header>

    {build.synergyNotes.length > 0 && (
      <section class="synergy-panel" aria-labelledby="synergy-title">
        <p class="eyebrow text-white/60">{strings.playEyebrow}</p>
        <h2 id="synergy-title">{strings.sectionSynergy}</h2>
        <ul role="list">
          {build.synergyNotes.map((note) => <li>{note}</li>)}
        </ul>
      </section>
    )}

    <section class="detail-section" aria-labelledby="team-title">
      <p class="eyebrow">{strings.teamEyebrow}</p>
      <h2 id="team-title">{strings.sectionTeam}</h2>
      <ol role="list" class="detail-list">
        {build.pals.map((slot, index) => (
          <li class="detail-card">
            <div class="detail-card-head">
              <span class="detail-number">{String(index + 1).padStart(2, "0")}</span>
              <PalAvatar iconUrl={slot.iconUrl} name={slot.name} class="size-11" />
              <h3>{slot.name}</h3>
              {slot.elements.map((element) => <ElementBadge element={element} locale={locale} />)}
            </div>
            <div class="mt-3 flex flex-wrap gap-1.5">{slot.role.map((role) => <Badge>{labels.role.get(role) ?? role}</Badge>)}</div>
            <p>{slot.explanation}</p>
          </li>
        ))}
      </ol>
    </section>

    {build.equipment.length > 0 && (
      <section class="detail-section" aria-labelledby="equipment-title">
        <p class="eyebrow">{strings.equipmentEyebrow}</p>
        <h2 id="equipment-title">{strings.sectionEquipment}</h2>
        <ul role="list" class="detail-list">
          {build.equipment.map((equipment) => (
            <li class="detail-card">
              <div class="detail-card-head">
                <ItemIcon iconUrl={equipment.iconUrl} class="size-11" />
                <h3>{equipment.name}</h3>
                <Badge>{labels.equipmentKind.get(equipment.kind) ?? equipment.kind}</Badge>
                <Badge class={equipment.status === "required" ? "border-[var(--coral)] bg-[#fbe3dc] text-[var(--coral-dark)]" : ""}>{labels.equipmentStatus.get(equipment.status) ?? equipment.status}</Badge>
              </div>
              {equipment.reason && <p>{equipment.reason}</p>}
              {equipment.alternatives.length > 0 && <p class="text-xs">{strings.alternativesPrefix} {equipment.alternatives.map((alternative) => alternative.name).join(", ")}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {build.alternatives.length > 0 && (
      <section class="detail-section" aria-labelledby="alternatives-title">
        <p class="eyebrow">{strings.alternativesEyebrow}</p>
        <h2 id="alternatives-title">{strings.sectionAlternatives}</h2>
        <ul role="list" class="detail-list">
          {build.alternatives.map((alternative) => (
            <li class="detail-card">
              <div class="detail-card-head">
                <PalAvatar iconUrl={alternative.palIconUrl} name={alternative.palName} class="size-9" />
                <h3>{alternative.palName} <span class="font-sans text-sm font-medium text-[var(--ink-soft)]">{strings.replaces} {alternative.replacesPalName}</span></h3>
              </div>
              <p>{alternative.reason}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <footer class="detail-footer">
      <dl>
        <div><dt>{strings.gameVersionLabel}</dt><dd>{build.gameVersion}</dd></div>
        <div><dt>{strings.verificationLabel}</dt><dd>{labels.verification.get(build.verification) ?? build.verification}</dd></div>
        <div><dt>{strings.sourceLabel}</dt><dd><a href={build.source.url} target="_blank" rel="noopener noreferrer" class="font-bold text-[var(--coral-dark)] underline underline-offset-2">{build.source.title ?? build.source.url}</a><span class="block text-[var(--ink-soft)]">{capturedDate}</span></dd></div>
      </dl>
    </footer>
  </main>
</Layout>
